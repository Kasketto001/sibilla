# Copia questo file in server/.env e compila ciò che ti serve. Nulla è obbligatorio:
# le chiavi dei modelli si possono inserire anche dall'app («Accesso ai modelli»).

# Chiavi API dei fornitori di modelli (una basta)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Account: "off" disattiva il login (solo su una macchina raggiungibile soltanto da te)
# SIBILLA_AUTH=off
# Dopo il primo account la registrazione si chiude; "open" la riapre a chiunque raggiunga il server
# SIBILLA_SIGNUP=open
# Segreto con cui vengono cifrate le chiavi API salvate dall'app (se assente ne viene creato uno in .sibilla-secret)
# SIBILLA_SECRET=

# Percorsi e porta
# SIBILLA_DB=./sibilla.db
# SIBILLA_LIBS=./.sibilla-libs
# PORT=8787
